  "headings": [
    {
      "level": 1,
      "text": "Styrk trivslen i dit arbejdsliv gennem praktiske forløb og konkrete øvelser",
      "fontSize": "64px",
      "fontWeight": "300",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Tag en genvej",
      "fontSize": "40px",
      "fontWeight": "700",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Nogle gange kræver det blot, at du lukker øjnene",
      "fontSize": "32.9623px",
      "fontWeight": "300",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Spørg om det svære. Få enkelte og konkrete svar.",
      "fontSize": "32.9623px",
      "fontWeight": "300",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Frit at bruge. Dyrt at undvære",
      "fontSize": "37.7352px",
      "fontWeight": "300",
      "color": "#00051B"
    },
    {
      "level": 3,
      "text": "Lær feedback der gør en forskel",
      "fontSize": "20px",
      "fontWeight": "400",
      "color": "#00051B"
    },
    {
      "level": 3,
      "text": "Find dine pauser - test dig selv",
      "fontSize": "20px",
      "fontWeight": "400",
      "color": "#00051B"
    },
    {
      "level": 3,
      "text": "Meditation: Et øjebliks hvile fra tankerne",
      "fontSize": "20px",
      "fontWeight": "400",
      "color": "#00051B"
    },
    {
      "level": 3,
      "text": "Er du ligevægts- eller spændingssøgende?",
      "fontSize": "20px",
      "fontWeight": "400",
      "color": "#00051B"
    },
    {
      "level": 3,
      "text": "Få bedre overblik og stærkere koordinering",
      "fontSize": "20px",
      "fontWeight": "400",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Målrettet restaurationsbranchen",
      "fontSize": "32.9623px",
      "fontWeight": "300",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Skabt til mediebranchens pres",
      "fontSize": "32.9623px",
      "fontWeight": "300",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Ekspertviden på bare 20 minutter",
      "fontSize": "40px",
      "fontWeight": "700",
      "color": "#FFFFFF"
    },
    {
      "level": 2,
      "text": "Gør Nectool.dk bedre",
      "fontSize": "24px",
      "fontWeight": "400",
      "color": "#00051B"
    },
    {
      "level": 2,
      "text": "Bliv en del af forandringen",
      "fontSize": "24px",
      "fontWeight": "400",
      "color": "#00051B"
    }
  ],
  "ctas": [
    {
      "text": "Kom i gang",
      "href": "https://nectool.dk/aktiver-din-personlige-udvikling"
    },
    {
      "text": "Find en god pause og styrk din hjerne",
      "href": "https://nectool.dk/tag-bare-en-pause"
    },
    {
      "text": "Se alt vores indhold",
      "href": "https://nectool.dk/find-indhold"
    },
    {
      "text": "Se hele pakken",
      "href": "https://nectool.dk/restauration"
    },
    {
      "text": "Få en opdateret værktøjskasse",
      "href": "https://nectool.dk/mediebranchen"
    },
    {
      "text": "Forstå, hvordan vi arbejder med indholdet",
      "href": "https://nectool.dk/handplukket-og-tilpasset-indhold"
    }
  ],
